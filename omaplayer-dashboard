def main():
    wave_frames = [
        " ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı ",
        " ıl.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı ",
        " ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lı ",
        " llı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ıl ",
        " lı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı.ıllı.ılı.lıllılı. "
    ]
    frame_idx = 0

    # Hide cursor for flicker-free gaming-grade rendering
    sys.stdout.write("\033[?25l")
    sys.stdout.flush()

    try:
        while True:
            data = get_playback_metrics()
            cols, lines = shutil.get_terminal_size((80, 24))
            
            W = min(max(40, cols - 2), 68)
            inner_w = W - 4

            status = data.get("status", "STOPPED")
            is_playing = (status == "PLAYING")
            title = data.get("title", "Müzik Çalmıyor")
            artist = data.get("artist", "")
            raw_src = data.get("source_name", "OmaPlayer")
            src_label = re.sub(r'[^\x00-\x7F]+', '', raw_src).strip() or "OmaPlayer"
            quality = data.get("quality_label", "Standart")
            is_lossless = data.get("is_lossless", False)

            pos = data.get("position_sec", 0)
            length = data.get("length_sec", 0)
            vol = data.get("volume_pct", 85)

            track_full = f"{title} • {artist}" if artist else title
            if is_playing:
                st_badge = "\033[1;32m▶ CALIYOR\033[0m"
                wave = wave_frames[frame_idx % len(wave_frames)]
            elif status == "PAUSED":
                st_badge = "\033[1;33m⏸ DURDU\033[0m"
                wave = " ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ "
            else:
                st_badge = "\033[0;90m■ KAPALI\033[0m"
                wave = " ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ "

            # Build double-buffered output frame in memory to prevent all flicker
            buf = []
            buf.append("\033[H\033[J")
            buf.append("\033[1;36m" + "┌" + ("─" * (inner_w + 2)) + "┐" + "\033[0m")

            # Header
            h_left = "  \033[1;37mOMAPLAYER\033[0m"
            h_right = f"[{src_label[:12]}]"
            spaces = max(1, inner_w - len(strip_ansi(h_left)) - len(h_right) - 2)
            buf.append(make_row(h_left + (" " * spaces) + f"\033[0;90m{h_right}\033[0m", inner_w))
            buf.append("\033[1;36m" + "├" + ("─" * (inner_w + 2)) + "┤" + "\033[0m")

            # Track Info
            buf.append(make_row("", inner_w))
            t_styled = f"  \033[1;32m{track_full[:inner_w-4]}\033[0m"
            buf.append(make_row(t_styled, inner_w))

            # Quality & Format
            q_color = "\033[1;35m" if is_lossless else "\033[1;33m"
            q_line = f"  {q_color}{quality[:inner_w-4]}\033[0m"
            buf.append(make_row(q_line, inner_w))

            # Progress
            p_bar = render_progress_bar(pos, length, max(8, inner_w - 26))
            p_styled = f"  {st_badge} {p_bar}  \033[0;90m%{vol}\033[0m"
            buf.append(make_row(p_styled, inner_w))

            # Wave
            buf.append(make_row("", inner_w))
            w_styled = f"  \033[1;36m{wave[:inner_w-4]}\033[0m"
            buf.append(make_row(w_styled, inner_w))
            buf.append(make_row("", inner_w))

            # Divider
            buf.append("\033[1;36m" + "├" + ("─" * (inner_w + 2)) + "┤" + "\033[0m")

            # Footer
            f1 = "  \033[1;32m1\033[0m:Spotify \033[1;31m2\033[0m:YT \033[1;33m3\033[0m:Radyo \033[1;35mp\033[0m:Listeler \033[1;36m5\033[0m:Hesap \033[1;37mf\033[0m:Ara"
            buf.append(make_row(f1, inner_w))

            f2 = "  \033[1;37mSpace\033[0m:Oynat/Dur   \033[1;37m+/-\033[0m:Ses   \033[1;31mx\033[0m:Durdur   \033[1;31mq\033[0m:Cikis"
            buf.append(make_row(f2, inner_w))

            buf.append("\033[1;36m" + "└" + ("─" * (inner_w + 2)) + "┘" + "\033[0m")

            # Single atomic flush to terminal
            sys.stdout.write("\n".join(buf) + "\n")
            sys.stdout.flush()

            frame_idx += 1
            key = get_key()

            if key in ('q', 'Q', 'ESC'):
                break
            elif key == ' ':
                run_action_fast(["--play-pause"])
            elif key in ('f', 'F'):
                search_dialog()
            elif key in ('p', 'P', '4'):
                playlists_dialog()
            elif key in ('+', '=', 'UP'):
                run_action_fast(["--vol-up"])
            elif key in ('-', '_', 'DOWN'):
                run_action_fast(["--vol-down"])
            elif key in ('x', 'X'):
                run_action_fast(["--stop"])
            elif key == '1':
                search_dialog()
            elif key == '2':
                search_dialog()
            elif key == '3':
                radio_dialog()
            elif key == '5':
                account_dialog()
    finally:
        # Restore terminal cursor
        sys.stdout.write("\033[?25h\n")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
