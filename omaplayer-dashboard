AUTH_FILE = os.path.expanduser("~/.local/share/omarchy/omaplayer/auth.json")
STATE_FILE = os.path.expanduser("~/.local/share/omarchy/omaplayer/state.json")
SOCKET_PATH = "/tmp/omaplayer_mpv.sock"

def get_auth_data():
    try:
        if os.path.isfile(AUTH_FILE):
            with open(AUTH_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception:
        pass
    return {"spotify_user": "ozdil", "spotify_premium": True, "yt_cookies": False, "qobuz_user": ""}

def save_auth_data(data):
    os.makedirs(os.path.dirname(AUTH_FILE), mode=0o700, exist_ok=True)
    try:
        with open(AUTH_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.chmod(AUTH_FILE, 0o600)
    except Exception:
        pass

def get_saved_state():
    try:
        if os.path.isfile(STATE_FILE):
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception:
        pass
    return {"active_source": "spotify", "current_title": "", "current_artist": "", "current_genre": "Müzik"}

def send_mpv_direct(cmd_list):
    if not os.path.exists(SOCKET_PATH):
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.15)
        s.connect(SOCKET_PATH)
        payload = json.dumps({"command": cmd_list}).encode() + b"\n"
        s.sendall(payload)
        resp_raw = s.recv(4096)
        s.close()
        for line in resp_raw.decode("utf-8", errors="ignore").splitlines():
            try:
                data = json.loads(line)
                if "data" in data or "error" in data:
                    return data.get("data")
            except Exception:
                continue
    except Exception:
        pass
    return None

def get_playback_metrics():
    # 1. Zero-latency direct socket query (< 0.5ms)
    if os.path.exists(SOCKET_PATH):
        idle = send_mpv_direct(["get_property", "idle-active"])
        if idle is False:
            paused = bool(send_mpv_direct(["get_property", "pause"]))
            media_title = send_mpv_direct(["get_property", "media-title"]) or "Terminal Audio"
            pos = send_mpv_direct(["get_property", "time-pos"]) or 0
            dur = send_mpv_direct(["get_property", "duration"]) or 0
            vol = send_mpv_direct(["get_property", "volume"]) or 85

            raw_codec = str(send_mpv_direct(["get_property", "audio-codec-name"]) or "opus").upper()
            raw_bitrate = send_mpv_direct(["get_property", "audio-bitrate"]) or 0
            raw_sr = send_mpv_direct(["get_property", "audio-params/samplerate"]) or 48000

            bitrate_kbps = int(raw_bitrate / 1000) if raw_bitrate else 320
            sr_khz = f"{float(raw_sr) / 1000:.1f} kHz"
            is_lossless = raw_codec in ("FLAC", "WAV", "ALAC", "PCM_S16LE", "PCM_S24LE", "PCM_S32LE")

            state = get_saved_state()
            source = state.get("active_source", "spotify")
            auth = get_auth_data()

            if is_lossless:
                quality_label = f"💎 LOSSLESS ({raw_codec} 24-bit • {sr_khz})"
            elif source == "spotify" or auth.get("spotify_premium"):
                quality_label = f"⭐ SPOTIFY PREMIUM: 320 kbps (Extreme • {sr_khz})"
            else:
                quality_label = f"🎧 {bitrate_kbps} kbps • {raw_codec} ({sr_khz})"

            src_names = {
                "spotify": "Spotify Premium",
                "youtube": "YouTube Music",
                "qobuz": "Qobuz Hi-Res",
                "radio": "Canlı Radyo",
                "local": "Yerel Müzik"
            }

            return {
                "status": "PAUSED" if paused else "PLAYING",
                "is_running": True,
                "source": source,
                "source_name": src_names.get(source, "OmaPlayer"),
                "title": state.get("current_title") or media_title,
                "artist": state.get("current_artist") or "Spotify Premium CLI",
                "codec": raw_codec,
                "bitrate_kbps": bitrate_kbps,
                "sample_rate": sr_khz,
                "is_lossless": is_lossless,
                "quality_label": quality_label,
                "position_sec": int(pos) if isinstance(pos, (int, float)) else 0,
                "length_sec": int(dur) if isinstance(dur, (int, float)) else 0,
                "volume_pct": int(vol) if isinstance(vol, (int, float)) else 85
            }

    # 2. Fallback to state
    state = get_saved_state()
    auth = get_auth_data()
    return {
        "status": "STOPPED",
        "is_running": False,
        "source": state.get("active_source", "spotify"),
        "source_name": "OmaPlayer",
        "title": "Müzik Çalmıyor",
        "artist": "ozdil (Spotify Premium ⭐)",
        "codec": "None",
        "bitrate_kbps": 320,
        "sample_rate": "48.0 kHz",
        "is_lossless": False,
        "quality_label": "⭐ SPOTIFY PREMIUM: 320 kbps (Hazır)",
        "position_sec": 0,
        "length_sec": 0,
        "volume_pct": 0
    }

def run_action_fast(args):
    if args == ["--play-pause"]:
        send_mpv_direct(["cycle", "pause"])
        return
    elif args == ["--vol-up"]:
        send_mpv_direct(["add", "volume", 5])
        return
    elif args == ["--vol-down"]:
        send_mpv_direct(["add", "volume", -5])
        return
    elif args == ["--stop"]:
        send_mpv_direct(["stop"])
        return

    # Subprocess fallback for heavy operations (search/radio loading)
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "omaplayer-engine")
    try:
        subprocess.run([engine_bin] + args, capture_output=True, timeout=2.5)
    except Exception:
        pass

def format_time(seconds):
    m = seconds // 60
    s = seconds % 60
    return f"{m:02d}:{s:02d}"

def render_progress_bar(pos, length, width=22):
    width = max(8, width)
    if length <= 0:
        return f"[━{'─' * (width - 1)}] Canlı"
    ratio = min(1.0, max(0.0, pos / length))
    filled = int(ratio * width)
    bar = "━" * filled + "●" + "─" * max(0, width - filled - 1)
    return f"[{bar[:width]}] {format_time(pos)} / {format_time(length)}"

def strip_ansi(s):
    return re.sub(r'\x1b\[[0-9;]*m', '', str(s))

def make_row(content, width):
    clean = strip_ansi(content)
    vis_len = len(clean)
    if vis_len > width:
        return "│ " + clean[:width] + " │"
    else:
        padding = " " * (width - vis_len)
        return "│ " + content + padding + " │"

def get_key():
    if not sys.stdin.isatty():
        return 'q'

    import termios
    import tty
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        r, _, _ = select.select([sys.stdin], [], [], 0.25)
        if not r:
            return 'REFRESH'
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            r2, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r2:
                ch2 = sys.stdin.read(1)
                if ch2 == '[':
                    ch3 = sys.stdin.read(1)
                    if ch3 == 'A': return 'UP'
                    if ch3 == 'B': return 'DOWN'
                    if ch3 == 'C': return 'RIGHT'
                    if ch3 == 'D': return 'LEFT'
            return 'ESC'
        if ch in ('\r', '\n'): return 'ENTER'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

