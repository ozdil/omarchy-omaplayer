#!/usr/bin/env python3
import os
import sys
import subprocess
import json
import time
import select
import shutil
import re

AUTH_FILE = os.path.expanduser("~/.local/share/omarchy/omaplayer/auth.json")

def get_auth_data():
    try:
        if os.path.isfile(AUTH_FILE):
            with open(AUTH_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception:
        pass
    return {"spotify_user": "", "spotify_premium": False, "yt_cookies": False, "qobuz_user": ""}

def save_auth_data(data):
    os.makedirs(os.path.dirname(AUTH_FILE), mode=0o700, exist_ok=True)
    try:
        with open(AUTH_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.chmod(AUTH_FILE, 0o600)
    except Exception:
        pass

def get_key():
    if not sys.stdin.isatty():
        return 'q'

    import termios
    import tty
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        r, _, _ = select.select([sys.stdin], [], [], 0.35)
        if not r:
            return 'REFRESH'
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            r2, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r2:
                ch2 = sys.stdin.read(1)
                if ch2 == '[':
                    ch3 = sys.stdin.read(1)
                    if ch3 == 'A': return 'UP'
                    if ch3 == 'B': return 'DOWN'
                    if ch3 == 'C': return 'RIGHT'
                    if ch3 == 'D': return 'LEFT'
            return 'ESC'
        if ch in ('\r', '\n'): return 'ENTER'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def get_engine_data():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "omaplayer-engine")
    try:
        res = subprocess.run([engine_bin, "--json"], capture_output=True, text=True, timeout=1.2)
        return json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        return {}

def run_action(args):
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "omaplayer-engine")
    try:
        subprocess.run([engine_bin] + args, capture_output=True, timeout=2.0)
    except Exception:
        pass

def format_time(seconds):
    m = seconds // 60
    s = seconds % 60
    return f"{m:02d}:{s:02d}"

def render_progress_bar(pos, length, width=20):
    width = max(8, width)
    if length <= 0:
        return f"[━{'─' * (width - 1)}] Canlı"
    ratio = min(1.0, max(0.0, pos / length))
    filled = int(ratio * width)
    bar = "━" * filled + "●" + "─" * max(0, width - filled - 1)
    return f"[{bar[:width]}] {format_time(pos)} / {format_time(length)}"

def strip_ansi(s):
    # Remove ANSI and wide unicode non-ascii symbols for strict column width math
    clean = re.sub(r'\x1b\[[0-9;]*m', '', str(s))
    return clean

def make_row(content, width):
    clean = strip_ansi(content)
    vis_len = len(clean)
    if vis_len > width:
        return "│ " + clean[:width] + " │"
    else:
        padding = " " * (width - vis_len)
        return "│ " + content + padding + " │"

