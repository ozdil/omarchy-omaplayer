def local_music_menu():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "omaplayer-engine")
    
    os.system("clear")
    print("\033[1;35m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
    print("║  📁 \033[1;37mYEREL MÜZİK ARŞİVİ (~/Music)\033[0m                                             ║")
    print("\033[1;35m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m\n")

    try:
        res = subprocess.run([engine_bin, "--list-local"], capture_output=True, text=True, timeout=1.5)
        tracks = json.loads(res.stdout) if res.returncode == 0 else []
    except Exception:
        tracks = []

    if not tracks:
        print("  \033[1;33m~/Music klasöründe ses dosyası (.flac, .mp3, .wav) bulunamadı.\033[0m\n")
        input("  Devam etmek için Enter'a basın...")
        return

    for idx, t in enumerate(tracks[:15]):
        print(f"  \033[1;36m[{idx+1:02d}]\033[0m 🎵 {t['name']}")

    print("\n  \033[0;90m[q] Geri Dön\033[0m\n")
    try:
        c = input("  Çalmak İstediğiniz Parça Numarası: ").strip()
        if c.isdigit():
            val = int(c)
            if 1 <= val <= len(tracks):
                run_action(["--play-file", tracks[val-1]["path"]])
    except Exception:
        pass

def main():
    anim_frames = [
        " ▂▃▅▆▇▆▅▃ ",
        "▃▅▆▇█▇▆▅▃ ",
        "▅▆▇█▇▆▅▃▂ ",
        "▆▇█▇▆▅▃▂  ",
        "█▇▆▅▃▂  ▂ ",
        "▇▆▅▃▂ ▂▃▅ "
    ]
    frame_idx = 0

    while True:
        data = get_engine_data()
        status = data.get("status", "STOPPED")
        is_running = data.get("is_running", False)
        source_name = data.get("source_name", "OmaPlayer")
        title = data.get("title", "Müzik Çalmıyor")
        artist = data.get("artist", "CLI Çalar Hazır")
        pos = data.get("position_sec", 0)
        length = data.get("length_sec", 0)
        vol = data.get("volume_pct", 85)

        os.system("clear")
        print("\033[1;35m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
        print(f"║  󰎆 \033[1;37mOMAPLAYER\033[0m • \033[1;33mSaf Terminal Müzik & Radyo Stüdyosu\033[0m [{source_name:<18}]   ║")
        print("\033[1;35m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m\n")

        if is_running:
            status_icon = "▶️ ÇALIYOR" if status == "PLAYING" else "⏸️ DURAKLATILDI"
            status_color = "\033[1;32m" if status == "PLAYING" else "\033[1;33m"
            wave = anim_frames[frame_idx % len(anim_frames)] if status == "PLAYING" else " ▂▃▂ ▂▃▂ "
            frame_idx += 1

            print(f"  {status_color}{status_icon}\033[0m   \033[1;36m{wave}\033[0m\n")
            print(f"  🎵 \033[1;37mParça:\033[0m   \033[1;32m{title}\033[0m")
            print(f"  👤 \033[1;37mSanatçı:\033[0m \033[1;36m{artist}\033[0m")
            print()
            print(f"  ⏱️  {render_progress_bar(pos, length, 32)}")
            print(f"  {render_volume_bar(vol)}")
        else:
            print("  \033[1;33mℹ️  Şu anda müzik çalmıyor.\033[0m")
            print("  Arama yapmak için \033[1;32m[f]\033[0m, Canlı Radyo için \033[1;36m[r]\033[0m, Yerel Müzik için \033[1;35m[m]\033[0m tuşuna basın.\n")

        print("\n\033[1;35m──────────────────────────────────────────────────────────────────────────────\033[0m")
        print("  \033[1;32m[f]\033[0m 🔍 Şarkı Ara & Çal (YT/Web) | \033[1;36m[r]\033[0m 📻 Canlı Radyolar | \033[1;35m[m]\033[0m 📁 Yerel Müzik")
        print("  \033[1;37m[Space]\033[0m ⏯️ Oynat / Duraklat    | \033[1;37m[+ / -]\033[0m 🔊 Ses (%5)    | \033[1;31m[x]\033[0m ⏹️ Durdur")
        print("  \033[1;31m[q]\033[0m 🚪 Çıkış (Arka planda çalmaya devam eder)")
        print("\033[1;35m──────────────────────────────────────────────────────────────────────────────\033[0m")

        key = get_key()

        if key in ('q', 'Q', 'ESC'):
            break
        elif key == ' ':
            run_action(["--play-pause"])
        elif key in ('f', 'F', '1'):
            search_and_play_menu()
        elif key in ('r', 'R', '2'):
            radio_menu()
        elif key in ('m', 'M', '3'):
            local_music_menu()
        elif key in ('+', '=', 'UP'):
            run_action(["--vol-up"])
        elif key in ('-', '_', 'DOWN'):
            run_action(["--vol-down"])
        elif key in ('x', 'X'):
            run_action(["--stop"])

if __name__ == "__main__":
    main()
