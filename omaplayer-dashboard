    ]
    frame_idx = 0

    while True:
        auth = get_auth_data()
        data = get_engine_data()
        cols, lines = shutil.get_terminal_size((80, 24))

        os.system("clear")
        if cols >= 96 and lines >= 16:
            # Fullscreen / Wide Studio Mode
            render_fullscreen_view(data, auth, osc_frames, frame_idx, cols, lines)
        else:
            # Compact / Floating Mini Window Mode
            render_compact_view(data, auth, osc_frames, frame_idx)

        frame_idx += 1
        key = get_key()

        if key in ('q', 'Q', 'ESC'):
            break
        elif key == ' ':
            run_action(["--play-pause"])
        elif key in ('f', 'F'):
            search_dialog()
        elif key in ('+', '=', 'UP'):
            run_action(["--vol-up"])
        elif key in ('-', '_', 'DOWN'):
            run_action(["--vol-down"])
        elif key in ('x', 'X'):
            run_action(["--stop"])
        elif key == '1':
            search_dialog()
        elif key == '2':
            search_dialog()
        elif key == '3':
            radio_dialog()
        elif key == '4':
            print("\n  Yerel Müzik taranıyor...")
            run_action(["--list-local"])
            time.sleep(0.5)
        elif key == '5':
            account_dialog()

if __name__ == "__main__":
