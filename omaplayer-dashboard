def main():
    anim_frames = [
        " ▂▃▅▆▇▆▅▃ ",
        "▃▅▆▇█▇▆▅▃ ",
        "▅▆▇█▇▆▅▃▂ ",
        "▆▇█▇▆▅▃▂  ",
        "█▇▆▅▃▂  ▂ ",
        "▇▆▅▃▂ ▂▃▅ "
    ]
    frame_idx = 0

    while True:
        data = get_engine_data()
        status = data.get("status", "STOPPED")
        is_running = data.get("is_running", False)
        source = data.get("source", "spotify")
        source_name = data.get("source_name", "OmaPlayer")
        title = data.get("title", "Müzik Çalmıyor")
        artist = data.get("artist", "")
        album = data.get("album", "")
        pos = data.get("position_sec", 0)
        length = data.get("length_sec", 0)
        vol = data.get("volume_pct", 85)

        os.system("clear")
        print("\033[1;35m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
        print(f"║  󰎆 \033[1;37mOMAPLAYER\033[0m • \033[1;33mEvrensel Müzik & Radyo Stüdyosu\033[0m [{source_name:<20}]   ║")
        print("\033[1;35m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m\n")

        if is_running:
            status_icon = "▶️ ÇALIYOR" if status == "PLAYING" else "⏸️ DURAKLATILDI"
            status_color = "\033[1;32m" if status == "PLAYING" else "\033[1;33m"
            wave = anim_frames[frame_idx % len(anim_frames)] if status == "PLAYING" else " ▂▃▂ ▂▃▂ "
            frame_idx += 1

            print(f"  {status_color}{status_icon}\033[0m   \033[1;36m{wave}\033[0m\n")
            print(f"  🎵 \033[1;37mParça:\033[0m   \033[1;32m{title}\033[0m")
            print(f"  👤 \033[1;37mSanatçı:\033[0m \033[1;36m{artist}\033[0m")
            if album:
                print(f"  💿 \033[1;37mAlbüm:\033[0m   \033[0;90m{album}\033[0m")
            print()
            print(f"  ⏱️  {render_progress_bar(pos, length, 32)}")
            print(f"  {render_volume_bar(vol)}")
        else:
            print(f"  \033[1;33m⚠️  {source_name} şu anda aktif veya çalmıyor.\033[0m")
            print("  Platformu başlatmak için \033[1;32m[l]\033[0m, kaynağı değiştirmek için \033[1;36m[s]\033[0m tuşuna basın.\n")

        print("\n\033[1;35m──────────────────────────────────────────────────────────────────────────────\033[0m")
        print("  \033[1;37m[Space]\033[0m ⏯️ Oynat/Dur | \033[1;37m[n]\033[0m ⏭️ Sonraki | \033[1;37m[p]\033[0m ⏮️ Önceki | \033[1;37m[+ / -]\033[0m 🔊 Ses")
        print("  \033[1;33m[s]\033[0m 🔀 Kaynak Değiştir (Spotify/YT/Qobuz/Radyo) | \033[1;36m[r]\033[0m 📻 Radyo Listesi")
        print("  \033[1;32m[l]\033[0m 🚀 Platformu Aç                          | \033[1;31m[q]\033[0m 🚪 Çıkış")
        print("\033[1;35m──────────────────────────────────────────────────────────────────────────────\033[0m")

        key = get_key()

        if key in ('q', 'Q', 'ESC'):
            break
        elif key == ' ':
            run_action("--play-pause")
        elif key in ('n', 'N', 'RIGHT'):
            run_action("--next")
        elif key in ('p', 'P', 'LEFT'):
            run_action("--prev")
        elif key in ('+', '=', 'UP'):
            run_action("--vol-up")
        elif key in ('-', '_', 'DOWN'):
            run_action("--vol-down")
        elif key in ('s', 'S'):
            select_source_menu()
        elif key in ('r', 'R'):
            select_radio_menu()
        elif key in ('l', 'L'):
            run_action("--launch")

if __name__ == "__main__":
    main()
