#!/usr/bin/env python3
import os
import sys
import subprocess
import json
import time
import select

def get_key():
    if not sys.stdin.isatty():
        return 'q'

    import termios
    import tty
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        r, _, _ = select.select([sys.stdin], [], [], 0.5)
        if not r:
            return 'REFRESH'
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            r2, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r2:
                ch2 = sys.stdin.read(1)
                if ch2 == '[':
                    ch3 = sys.stdin.read(1)
                    if ch3 == 'A': return 'UP'
                    if ch3 == 'B': return 'DOWN'
                    if ch3 == 'C': return 'RIGHT'
                    if ch3 == 'D': return 'LEFT'
            return 'ESC'
        if ch in ('\r', '\n'): return 'ENTER'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def get_engine_data():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "omaplayer-engine")
    try:
        res = subprocess.run([engine_bin, "--json"], capture_output=True, text=True, timeout=1.2)
        return json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        return {}

def run_action(args):
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "omaplayer-engine")
    try:
        subprocess.run([engine_bin] + args, capture_output=True, timeout=2.0)
    except Exception:
        pass

def format_time(seconds):
    m = seconds // 60
    s = seconds % 60
    return f"{m:02d}:{s:02d}"

def render_progress_bar(pos, length, width=32):
    if length <= 0:
        return f"[{'░' * width}] Canlı Akış / Yayın"
    ratio = min(1.0, max(0.0, pos / length))
    filled = int(ratio * width)
    bar = "█" * filled + "░" * (width - filled)
    return f"[{bar}] {format_time(pos)} / {format_time(length)}"

def render_volume_bar(vol, width=12):
    ratio = min(1.0, max(0.0, vol / 100.0))
    filled = int(ratio * width)
    bar = "█" * filled + "░" * (width - filled)
    return f"🔊 %{vol:<3} [{bar}]"

