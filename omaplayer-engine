def sanitize_str(s, max_len=60):
    return re.sub(r'[\x00-\x1f\x7f-\x9f]', '', str(s))[:max_len].strip()

def get_auth_data():
    try:
        if os.path.isfile(AUTH_FILE):
            with open(AUTH_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception:
        pass
    return {"spotify_user": "", "spotify_premium": False, "yt_cookies": False, "qobuz_user": ""}

def save_auth_data(data):
    try:
        with open(AUTH_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.chmod(AUTH_FILE, 0o600)
    except Exception:
        pass

def get_saved_state():
    try:
        if os.path.isfile(STATE_FILE):
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception:
        pass
    return {"active_source": "spotify", "current_title": "", "current_artist": "", "current_genre": "Müzik"}

def save_state(state):
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(state, f)
    except Exception:
        pass

def send_mpv_command(cmd_list):
    if not os.path.exists(SOCKET_PATH):
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.6)
        s.connect(SOCKET_PATH)
        payload = json.dumps({"command": cmd_list}).encode() + b"\n"
        s.sendall(payload)
        resp_raw = s.recv(4096)
        s.close()
        for line in resp_raw.decode("utf-8", errors="ignore").splitlines():
            try:
                data = json.loads(line)
                if "data" in data or "error" in data:
                    return data.get("data")
            except Exception:
                continue
    except Exception:
        pass
    return None

def ensure_mpv_running():
    if os.path.exists(SOCKET_PATH):
        res = send_mpv_command(["get_property", "idle-active"])
        if res is not None:
            return True
        try:
            os.remove(SOCKET_PATH)
        except Exception:
            pass

    proc = subprocess.Popen(
        [
            "/usr/bin/mpv",
            "--no-video",
            "--idle",
            f"--input-ipc-server={SOCKET_PATH}",
            "--ytdl-format=bestaudio/best",
            "--volume=85"
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )
    time.sleep(0.3)
    return os.path.exists(SOCKET_PATH)

def play_terminal_stream(url, title=None, artist=None, source_type="streaming"):
    ensure_mpv_running()
    send_mpv_command(["loadfile", url, "replace"])
    state = get_saved_state()
    state["active_source"] = source_type
    state["current_title"] = sanitize_str(title or "Canlı Yayın", 40)
    state["current_artist"] = sanitize_str(artist or "Terminal CLI", 35)
    save_state(state)
    return True

def play_query_stream(query, source_type="youtube"):
    ensure_mpv_running()
    clean_q = sanitize_str(query, 50)
    if not clean_q:
        return False
    ytdl_url = f"ytdl://ytsearch1:{clean_q}"
    send_mpv_command(["loadfile", ytdl_url, "replace"])
    state = get_saved_state()
    state["active_source"] = source_type
    state["current_title"] = clean_q
    state["current_artist"] = "YouTube Music CLI" if source_type == "youtube" else "Spotify CLI"
    save_state(state)
    return True

def get_spotify_mpris():
    try:
        res = subprocess.run(
            ["/usr/bin/busctl", "--user", "list"],
            capture_output=True, text=True, timeout=0.8,
            env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"}
        )
        for line in res.stdout.splitlines():
            if "org.mpris.MediaPlayer2" in line and ("spotify" in line.lower() or "ncspot" in line.lower()):
                m = re.search(r'(org\.mpris\.MediaPlayer2\.[a-zA-Z0-9_.-]+)', line)
                if m:
                    service = m.group(1)
                    # Query Title
                    meta_res = subprocess.run(
                        ["/usr/bin/busctl", "--user", "get-property", service, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Metadata"],
                        capture_output=True, text=True, timeout=0.6, env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"}
                    )
                    title = "Bilinmeyen Şarkı"
                    artist = "Spotify"
                    album = ""
                    if meta_res.returncode == 0:
                        m_t = re.search(r'"xesam:title"\s+s\s+"([^"]+)"', meta_res.stdout)
                        if m_t: title = m_t.group(1)
                        m_a = re.search(r'"xesam:artist"\s+(?:as\s+\d+\s+|s\s+)"([^"]+)"', meta_res.stdout)
                        if m_a: artist = m_a.group(1)
                        m_alb = re.search(r'"xesam:album"\s+s\s+"([^"]+)"', meta_res.stdout)
                        if m_alb: album = m_alb.group(1)

                    st_res = subprocess.run(
                        ["/usr/bin/busctl", "--user", "get-property", service, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"],
                        capture_output=True, text=True, timeout=0.6, env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"}
                    )
                    status = "PLAYING" if "Playing" in st_res.stdout else "PAUSED"
                    return {
                        "status": status,
                        "is_running": True,
                        "source": "spotify",
                        "source_name": "󰓇 Spotify Premium",
                        "title": sanitize_str(title, 40),
                        "artist": sanitize_str(artist, 35),
                        "album": sanitize_str(album, 35),
                        "position_sec": 0,
                        "length_sec": 0,
                        "volume_pct": 85,
                        "service": service
                    }
    except Exception:
        pass
    return None

def get_playback_info():
    # 1. Check Spotify MPRIS first if active
    sp_data = get_spotify_mpris()
    if sp_data and sp_data.get("status") == "PLAYING":
        return sp_data

    # 2. Check native terminal MPV engine
    if os.path.exists(SOCKET_PATH):
        idle = send_mpv_command(["get_property", "idle-active"])
        if idle is False:
            paused = bool(send_mpv_command(["get_property", "pause"]))
            media_title = send_mpv_command(["get_property", "media-title"]) or "Terminal Audio"
            pos = send_mpv_command(["get_property", "time-pos"]) or 0
            dur = send_mpv_command(["get_property", "duration"]) or 0
            vol = send_mpv_command(["get_property", "volume"]) or 85

            state = get_saved_state()
            source = state.get("active_source", "terminal")
            source_labels = {
                "spotify": "󰓇 Spotify CLI",
                "youtube": "󰗃 YouTube Music",
                "qobuz": "🎵 Qobuz Hi-Res",
                "radio": "📻 Canlı İnternet Radyosu",
                "local": "📁 Yerel Müzik Arşivi"
            }

            return {
                "status": "PAUSED" if paused else "PLAYING",
                "is_running": True,
                "source": source,
                "source_name": source_labels.get(source, "🎵 OmaPlayer"),
                "title": sanitize_str(state.get("current_title") or media_title, 40),
                "artist": sanitize_str(state.get("current_artist") or "Terminal Akış", 35),
                "album": "OmaPlayer Native Engine",
                "position_sec": int(pos) if isinstance(pos, (int, float)) else 0,
                "length_sec": int(dur) if isinstance(dur, (int, float)) else 0,
                "volume_pct": int(vol) if isinstance(vol, (int, float)) else 85,
                "service": "OmaPlayer MPV Daemon"
            }

    if sp_data:
        return sp_data

    state = get_saved_state()
    auth = get_auth_data()
    user_badge = auth.get("spotify_user") or "Misafir"
    return {
        "status": "STOPPED",
        "is_running": False,
        "source": state.get("active_source", "spotify"),
        "source_name": "🎵 OmaPlayer",
        "title": "Müzik Çalmıyor",
        "artist": f"Hesap: {user_badge}",
        "album": "",
        "position_sec": 0,
        "length_sec": 0,
        "volume_pct": 0,
        "service": "None"
    }

def control_playback(action):
    # If MPV is active, control via IPC
    if os.path.exists(SOCKET_PATH):
        if action == "play_pause":
            send_mpv_command(["cycle", "pause"])
            return True
        elif action == "vol_up":
            send_mpv_command(["add", "volume", 5])
            return True
        elif action == "vol_down":
            send_mpv_command(["add", "volume", -5])
            return True
        elif action == "stop":
            send_mpv_command(["stop"])
            return True

    # Fallback to Spotify MPRIS
    sp_data = get_spotify_mpris()
    if sp_data and sp_data.get("service"):
        srv = sp_data["service"]
        if action == "play_pause":
            subprocess.run(["/usr/bin/busctl", "--user", "call", srv, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlayPause"], capture_output=True)
            return True
        elif action == "next":
            subprocess.run(["/usr/bin/busctl", "--user", "call", srv, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Next"], capture_output=True)
            return True
        elif action == "prev":
            subprocess.run(["/usr/bin/busctl", "--user", "call", srv, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Previous"], capture_output=True)
            return True

    return False

def list_local_music():
    music_dir = os.path.expanduser("~/Music")
    if not os.path.exists(music_dir):
        return []
    tracks = []
    for root, _, files in os.walk(music_dir):
        for f in sorted(files):
            if f.lower().endswith((".mp3", ".flac", ".wav", ".m4a", ".ogg", ".opus")):
                f_path = os.path.join(root, f)
                tracks.append({
                    "name": sanitize_str(f[:40], 40),
                    "path": f_path
                })
            if len(tracks) >= 50:
                break
        if len(tracks) >= 50:
            break
    return tracks

def main():
    parser = argparse.ArgumentParser(description="OmaPlayer Universal Multi-Platform Engine")
    parser.add_argument("--json", action="store_true", help="Output JSON status")
    parser.add_argument("--play-pause", action="store_true", help="Toggle play/pause")
    parser.add_argument("--stop", action="store_true", help="Stop playback")
    parser.add_argument("--vol-up", action="store_true", help="Volume up 5 percent")
    parser.add_argument("--vol-down", action="store_true", help="Volume down 5 percent")
    parser.add_argument("--search", type=str, help="Search and stream track")
    parser.add_argument("--play-radio", type=str, help="Play radio station")
    parser.add_argument("--play-file", type=str, help="Play local audio file")
    parser.add_argument("--list-local", action="store_true", help="List local music")

    args = parser.parse_args()

    if args.search:
        play_query_stream(args.search, "spotify")
    elif args.play_radio:
        st = RADIO_STREAMS.get(args.play_radio, RADIO_STREAMS["lofi"])
        play_terminal_stream(st["url"], st["name"], st["genre"], "radio")
    elif args.play_file:
        if os.path.isfile(args.play_file):
            f_name = os.path.basename(args.play_file)
            play_terminal_stream(args.play_file, f_name, "Yerel Dosya", "local")
    elif args.play_pause:
        control_playback("play_pause")
    elif args.stop:
        control_playback("stop")
    elif args.vol_up:
        control_playback("vol_up")
    elif args.vol_down:
        control_playback("vol_down")
    elif args.list_local:
        print(json.dumps(list_local_music()))
        sys.exit(0)

    info = get_playback_info()
    print(json.dumps(info))

if __name__ == "__main__":
    main()
