    "lofi": {
        "name": "☕ Lofi Beats (Sakin / Kodlama)",
        "url": "https://stream.zeno.fm/f3wvbbqmdg8uv",
        "genre": "Lofi & Chill"
    },
    "jazz": {
        "name": "🎷 Jazz Radio Classics",
        "url": "https://jazz-wr01.ice.infomaniak.ch/jazz-wr01-128.mp3",
        "genre": "Jazz & Soul"
    },
    "synthwave": {
